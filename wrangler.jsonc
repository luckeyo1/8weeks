{
  // Cloudflare Workers 배포 설정 (OpenNext Cloudflare 어댑터)
  // https://opennext.js.org/cloudflare
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "8weeks",
  // OpenNext 생성 워커 + 크론(scheduled)을 붙인 진입점 (worker.ts 참고)
  "main": "worker.ts",
  "compatibility_date": "2025-03-25",
  // Next.js 서버 실행에 Node 호환 필요
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // 매일 알림: 15분마다 "정한 시각이 된 사람"에게 보낸다 (UTC 기준 실행, 시간 판단은 앱이 KST 로)
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  // Cloudflare D1 (SQLite) 데이터베이스 바인딩.
  // `wrangler d1 create prayer-together-db` 실행 후 나오는 database_id 로 교체하세요.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prayer-together-db",
      "database_id": "40957668-395d-44eb-9842-ca58d10d8615",
      "migrations_dir": "migrations"
    }
  ]
  // 공개 변수는 아래 "vars" 에, 비밀키(GOOGLE_CLIENT_SECRET, SESSION_SECRET)는
  // `wrangler secret put` 또는 대시보드(Settings → Variables and Secrets)로 주입합니다.
  // "vars": {
  //   "NEXT_PUBLIC_SITE_URL": "https://your-worker.workers.dev",
  //   "GOOGLE_CLIENT_ID": "xxxxx.apps.googleusercontent.com"
  // }
}
