# ── 공개 값 (빌드 시 인라인, next dev / next build 에서 사용) ──────────
# 로컬 개발이면 .env.local 로 복사해서 사용하세요.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# (선택) "오늘" 판정 기준 timezone. 기본 Asia/Seoul
# NEXT_PUBLIC_APP_TIME_ZONE=Asia/Seoul

# ── 서버 비밀키/바인딩은 여기 두지 않습니다 ──────────────────────────
# - D1(DB) 은 wrangler.jsonc 의 d1_databases 바인딩으로 주입됩니다.
# - GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / SESSION_SECRET 은
#   로컬: .dev.vars (아래 .dev.vars.example 참고)
#   배포: `wrangler secret put` 또는 Cloudflare 대시보드
